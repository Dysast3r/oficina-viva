{
  "name": "oficina-viva",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "tsx watch --clear-screen=false server/index.ts",
    "build": "npm run typecheck && vite build",
    "start": "tsx server/index.ts --prod",
    "reset-progress": "tsx server/reset-progress.ts",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.server.json"
  },
  "dependencies": {
    "express": "^5.3.0",
    "tsx": "^4.23.15"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^4.7.0",
    "phaser": "^4.2.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "~5.7",
    "vite": "^6.4.5"
  }
}
